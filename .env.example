# Copy to .env.local for local dev, and add the same two values in Vercel → Project → Settings → Environment Variables.
# Both come from Supabase → Project Settings → API. The anon key is safe in the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
