# Copy to .env.local for local dev, and add the same two values in Vercel → Project → Settings → Environment Variables.
# Both come from Supabase → Project Settings → API Keys. Use the project URL without /rest/v1/, and the publishable key
# (sb_publishable_…; older projects call it the anon key). It's safe in the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Server-only, for the daily Gmail sync (/api/sync). Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SYNC_SECRET=
